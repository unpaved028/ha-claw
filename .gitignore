# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
dist/
*.tsbuildinfo

# ── Secrets & local configuration ─────────────────────────────
# dev-options.json mirrors the add-on options and holds real API keys.
dev-options.json
.env
.env.*
!.env.example

# ── Local runtime data (created by `npm run dev`) ─────────────
/data/
ha-claw/data/

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors & IDEs ────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Local agent/tool state ────────────────────────────────────
.claude/settings.local.json
ha-claw/.claude/settings.local.json
.cursor/rules/*.local.mdc

# Cursor canvases are local analysis, not add-on source.
**/*.canvas.tsx
**/*.canvas.data.json

# Unpublished design briefs. Runtime prompts are main.md / main.en.md
# and the onboarding pair. A local copy of the old architect brief lives
# under .agents/ (already ignored above).
ha-claw/agents/KI-Systemarchitekt.md

# ── Scratch & report artifacts ────────────────────────────────
coverage/
lint-report.txt
ha-claw/test-*.ts
tmp_v*

# ── Internal AI agent workspace (not part of the public repo) ─
# Public agent instructions live in AGENTS.md instead.
.agents/
.gemini/
